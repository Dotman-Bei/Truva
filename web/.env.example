# Network values verified 2026-10-14 against https://dev-docs.botchain.ai/docs/Developers/quick-guide/
# and an eth_chainId call to the RPC (0x3c8 = 968). Re-verify before each release.
NEXT_PUBLIC_CHAIN_ENV=bohr-testnet
NEXT_PUBLIC_BOT_CHAIN_ID=968
NEXT_PUBLIC_BOT_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_BOT_EXPLORER_URL=https://scan.bohr.life

# BOT Chain public PRWA demo suite on Bohr testnet, from the RWA address table
# (https://dev-docs.botchain.ai/docs/RWA/deployment-addresses/). Verified on-chain 2026-10-14:
# name "Project Real World Asset", PRWA, 6 decimals; token.identityRegistry() and token.compliance()
# return the two addresses below. The token was PAUSED at verification time.
NEXT_PUBLIC_RWA_TOKEN_ADDRESS=0x922835859623d6F3b99a2742D585E093bBA0a740
NEXT_PUBLIC_RWA_IDENTITY_REGISTRY_ADDRESS=0x17e33C394Ab783D6786011d01681D8Ad540C5F53
NEXT_PUBLIC_RWA_COMPLIANCE_ADDRESS=0x1E2e2a848b611C121C86F77C703B8DD32DCdE37A
# Truva TestUSD on Bohr testnet (contracts/src/TestUSD.sol), deployed 2026-10-14.
NEXT_PUBLIC_PAYMENT_TOKEN_ADDRESS=0xA5064e9b0F54751C93A3283BAa605948f4dce56C

# Issuer wallets for the demo offering: payment goes to the treasury, delivery comes from inventory.
NEXT_PUBLIC_ISSUER_TREASURY_ADDRESS=
NEXT_PUBLIC_ISSUER_INVENTORY_ADDRESS=

# Storage. Set both Redis values in production (Upstash, or Vercel KV which sets KV_REST_API_URL/TOKEN).
# With neither set, Truva uses a local JSON file in .data/ (development only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Enables /checkout/preview-<state> pages that render each state with labelled example data.
# Never set this in a deployment testers use.
TRUVA_UI_PREVIEW=
